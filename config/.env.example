# =============================================================================
# Variables de entorno — plantilla (copiar y completar; nunca commitear el .env real)
#
#   Docker Compose lee el .env de la RAÍZ del repo:
#     copy config\.env.example .env        (Windows)
#     cp config/.env.example .env          (Linux/Mac)
#
#   Desarrollo local sin Docker: src/shared/config/database_settings.py busca
#   primero config/.env y, si no existe, el .env de la raíz.
# =============================================================================

# ---- PostgreSQL (Data Warehouse) --------------------------------------------
# DB_HOST=localhost para desarrollo local; en Docker se sobrescribe con 'postgres'.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=data_engineering
DB_USER=postgres
DB_PASSWORD=root

# ---- Rutas y logging ---------------------------------------------------------
DATA_DIR=./data
LOG_LEVEL=INFO

# ---- CSV ---------------------------------------------------------------------
CSV_ENCODING=latin1

# ---- Apache Airflow (solo docker-compose) ------------------------------------
# Usuario de la UI (http://localhost:8080). Valores de desarrollo: cambialos.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Password de la metadata DB de Airflow (contenedor airflow-metadata).
AIRFLOW_METADATA_PASSWORD=airflow

# Clave Fernet: cifra las Connections/Variables guardadas en la metadata DB.
# Generarla con cualquiera de estos comandos y pegar el resultado:
#   docker run --rm apache/airflow:2.9.1-python3.11 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"   (requiere pip install cryptography)
# Si se deja vacía, Airflow funciona pero guarda esos datos sin cifrar.
AIRFLOW_FERNET_KEY=

# Clave de sesión del webserver (cualquier string aleatorio largo).
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_WEBSERVER_SECRET_KEY=cambiar-por-un-string-aleatorio
